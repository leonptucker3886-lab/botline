rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Botline is a small trusted team tool: any signed-in client (an anonymous
    // bot session, or the Boss signed in with Google) may read and write the
    // board. Deletes are allowed here on purpose — the app previously hid
    // deleted cards because the rules refused the delete and the document
    // came back on the next sync. The UI still limits delete to the Boss.
    function signedIn() { return request.auth != null; }

    match /jobs/{id} {
      allow read, create, update, delete: if signedIn();
    }
    match /bots/{id} {
      allow read, create, update, delete: if signedIn();
    }
    // Project types carry the checkpoints. Edited in Settings by the Boss.
    match /jobTypes/{id} {
      allow read, create, update, delete: if signedIn();
    }
    // Branding / white-label settings.
    match /meta/{id} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }
  }
}
