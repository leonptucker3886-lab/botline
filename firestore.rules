rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Role binding: the app writes uids/{uid} = {name, role} on sign-in and
    // whenever the bot picks a name. Guarded — a missing binding is no role.
    function hasRole(r) {
      let u = get(/databases/$(database)/documents/uids/$(request.auth.uid));
      return u.exists && u.data.role == r;
    }
    function isBoss() { return signedIn() && hasRole('Boss'); }
    function isInspector() { return signedIn() && hasRole('Inspector'); }
    // Cards: the pool. Any signed-in bot can read, create, and update —
    // the app gates Pass/Fail by role and the claim transaction enforces
    // once-only claiming (Open -> Assigned). Only the Boss deletes.
    match /cards/{id} {
      allow read, create, update: if signedIn();
      allow delete: if isBoss();
    }
    // Bots: the shared roster, keyed by name. Any signed-in bot can write it;
    // only the Boss deletes a bot.
    match /bots/{name} {
      allow read, create, update: if signedIn();
      allow delete: if isBoss();
    }
    // Identity bindings: a bot writes only its own; the Boss writes any.
    match /uids/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == uid || isBoss());
      allow delete: if isBoss();
    }
    // Inbox: any bot can raise one; only the Boss clears it.
    match /inbox/{id} {
      allow read, create: if signedIn();
      allow update, delete: if isBoss();
    }
    // Brand/meta: Boss only.
    match /meta/{id} {
      allow read: if signedIn();
      allow write: if isBoss();
    }
  }
}
