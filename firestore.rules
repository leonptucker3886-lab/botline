rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/bots/$(request.auth.uid)).data.role;
    }
    function isBoss() { return signedIn() && role() == 'Boss'; }
    function isInspector() { return signedIn() && role() == 'Inspector'; }
    // Cards: the pool. Any signed-in bot can read and claim an Open card.
    // Only the owning bot, an inspector, or the Boss can change a claimed card.
    match /cards/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (
        (resource.data.status == 'Open' && request.resource.data.status == 'Assigned') ||
        resource.data.botUid == request.auth.uid || isInspector() || isBoss());
      allow delete: if isBoss();
    }
    // Bots: the roster. A bot writes its own doc; the Boss writes any.
    match /bots/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == uid || isBoss());
      allow delete: if isBoss();
    }
    // Inbox: any bot can raise one; only the Boss clears it.
    match /inbox/{id} {
      allow read, create: if signedIn();
      allow update, delete: if isBoss();
    }
    // Brand/meta: Boss only.
    match /meta/{id} {
      allow read: if signedIn();
      allow write: if isBoss();
    }
  }
}
